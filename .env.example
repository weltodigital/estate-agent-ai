# Copy this to `apps/web/.env.local` AND `apps/api/.env.local` and fill in
# the values marked REQUIRED. Defaults below are tuned for local development.

# --- Supabase (REQUIRED) --------------------------------------------------
# Grab from your Supabase dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (optional — needed for AI descriptions / staging suggest / floor-plan parse)
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
CLAUDE_VISION_MODEL=claude-sonnet-4-6

# --- External AI (optional — staging + enhancement upgrades use these) ---
REPLICATE_API_TOKEN=
# Replicate model slugs (owner/name; latest version is used). Defaults live in
# the orchestrator config — override to pin or swap models without a deploy.
REPLICATE_STAGING_MODEL=adirik/interior-design
REPLICATE_RELIGHT_MODEL=zsxkib/ic-light
REPLICATE_INPAINT_MODEL=zylim0702/remove-object

# --- AWS Rekognition (optional, used for face/plate detection in GDPR blur)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2

# --- Cloudflare R2 (optional locally — photo upload won't work without real values)
# Use placeholder strings to let the API boot in dev. Real Cloudflare creds
# only required when you want photo upload / staging / floor-plan exports
# to actually round-trip to storage.
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET_NAME=placeholder
R2_PUBLIC_BASE_URL=http://localhost:9999

# --- Cloudinary (optional) ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Stripe (optional locally) -------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=
STRIPE_TRIAL_DAYS=7

# --- UK property data (optional) ----------------------------------------
# Bearer token from get-energy-performance-data.communities.gov.uk → My Account
EPC_API_TOKEN=
OS_PLACES_API_KEY=

# --- Email + Queue ------------------------------------------------------
# Resend optional locally (when unset, invite emails are skipped and the
# admin shares the returned invite_url manually). EMAIL_FROM must use a
# domain verified in Resend. REDIS_URL is required by the API env schema;
# localhost is fine as a placeholder — the queue only fails on real AI jobs.
RESEND_API_KEY=
EMAIL_FROM=Privett <hello@useprivett.com>
# Where marketing contact-form submissions are emailed (defaults to hello@useprivett.com).
CONTACT_INBOX=hello@useprivett.com
REDIS_URL=redis://localhost:6379

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:3001
AI_ORCHESTRATOR_URL=http://localhost:8000
NODE_ENV=development

# --- AI orchestrator callback signing (shared secret API <-> orchestrator)
AI_CALLBACK_SECRET=local-dev-secret

# --- Sentry (optional) --------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Rate limits --------------------------------------------------------
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
