# ---------------------------------------------------------------------------
# Privett environment. Copy to .env.local (web) and set the same values on
# Vercel (web) and Railway (worker). Never commit real values.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (web + worker)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# The worker reads these two names:
SUPABASE_URL=
# (worker uses SUPABASE_SERVICE_ROLE_KEY above)

# Stripe (web). Price ids map to plans in packages/core/src/config/plans.ts
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly recurring, per-unit prices (quantity = branches):
#   Starter £39, Pro £99, Agency £79 per branch (minimum 2)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# Optional display labels on /pricing (defaults match the prices above; rebuild after changing)
# NEXT_PUBLIC_PRICE_STARTER_LABEL=£39 / month
# NEXT_PUBLIC_PRICE_PRO_LABEL=£99 / month
# NEXT_PUBLIC_PRICE_AGENCY_LABEL=£79 per branch / month

# AI engines (worker). Each engine is skipped if its key is missing.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model ids: config, not code. Check each provider's docs before changing.
# OPENAI_MODEL=gpt-5-mini
# PERPLEXITY_MODEL=fast            # Agent API preset, or a provider/model id
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_ENGINE_MODEL=claude-sonnet-5-5
# Parsing and fix-asset generation. claude-haiku-5-5 is far cheaper for parsing.
# ANTHROPIC_PARSER_MODEL=claude-opus-5-5
# ANTHROPIC_ASSET_MODEL=claude-opus-5-5
# Per-model prices (USD) for cost logging, overriding packages/core defaults:
# MODEL_PRICING_JSON={"gpt-5":{"inputPerMTok":1.25,"outputPerMTok":10,"perRequest":0.01}}

# Google Places (worker): Google Business Profile signals
GOOGLE_PLACES_API_KEY=

# Worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=4
WORKER_POLL_MS=5000

# Budgets and limits (USD), all optional
# FREE_SCAN_BUDGET_USD=0.75
# STARTER_SCAN_BUDGET_USD=4
# PRO_SCAN_BUDGET_USD=12
# AGENCY_SCAN_BUDGET_USD=10
# LEAGUE_BUDGET_USD=25
# LOW_SAMPLE_THRESHOLD=20
# FREE_SCAN_PER_EMAIL_PER_DAY=1
# FREE_SCAN_PER_DOMAIN_PER_WEEK=1
# FREE_SCAN_PER_IP_PER_DAY=3
# FREE_SCAN_GLOBAL_PER_DAY=200

# Free scan: salt for hashing IPs (web). Any long random string.
IP_HASH_SALT=

# Extra AI referral sources for the tracking snippet (JSON array), optional
# AI_REFERRERS_JSON=

# Claude engine cost controls (worker)
# ANTHROPIC_ENGINE_MAX_SEARCHES=2
# ANTHROPIC_ENGINE_EFFORT=medium
