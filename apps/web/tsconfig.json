{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "noUncheckedIndexedAccess": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-funnel/types/**/*.ts",
    ".next-home/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-demo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
