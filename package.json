{
  "name": "privett",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @privett/web dev",
    "dev:worker": "pnpm --filter @privett/worker dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css}\"",
    "test:db": "node supabase/tests/rls.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.8",
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
